<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeedReaderApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="SpeedReaderApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Speed Reader - Science-Backed RSVP Reader"
        Width="800" Height="600"
        Background="{Binding BackgroundColor}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with controls -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="10">
            <TextBlock Text="Speed Reader - RSVP with ORP"
                      FontSize="20"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Foreground="{Binding TextColor}"/>

            <!-- Speed controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Content="-" Click="DecreaseSpeed" Padding="10,5"/>
                <TextBlock Text="{Binding WPM, StringFormat='{}{0} WPM'}"
                          VerticalAlignment="Center"
                          FontSize="16"
                          FontWeight="Bold"
                          MinWidth="100"
                          TextAlignment="Center"
                          Foreground="{Binding TextColor}"/>
                <Button Content="+" Click="IncreaseSpeed" Padding="10,5"/>
            </StackPanel>

            <!-- Speed presets -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                <TextBlock Text="Presets:" VerticalAlignment="Center" Foreground="{Binding TextColor}"/>
                <Button Content="250" Click="SetSpeed250" Padding="8,4"/>
                <Button Content="300" Click="SetSpeed300" Padding="8,4"/>
                <Button Content="400" Click="SetSpeed400" Padding="8,4"/>
                <Button Content="500" Click="SetSpeed500" Padding="8,4"/>
                <Button Content="1000" Click="SetSpeed1000" Padding="8,4"/>
            </StackPanel>

            <TextBlock Text="💡 Science shows best comprehension at 250-350 WPM"
                      FontSize="12"
                      HorizontalAlignment="Center"
                      Foreground="#FFA500"/>
        </StackPanel>

        <!-- Main reading area -->
        <Grid Grid.Row="1">
            <Border Background="{Binding BackgroundColor}"
                   Padding="20">
                <Grid RowDefinitions="*,Auto,*">
                    <!-- Centered word display with ORP highlighting -->
                    <Viewbox Grid.Row="1"
                            MaxHeight="200"
                            Stretch="Uniform">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentWord}"
                                      FontSize="72"
                                      FontWeight="Bold"
                                      TextAlignment="Center"
                                      Foreground="{Binding TextColor}"/>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Definition popup -->
            <Border IsVisible="{Binding ShowDefinition}"
                   Background="#F0000000"
                   Padding="20">
                <Border Background="#FFFFFF"
                       CornerRadius="10"
                       Padding="20"
                       MaxWidth="500"
                       MaxHeight="400"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                  Text="Dictionary"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1">
                            <TextBlock Text="{Binding DefinitionText}"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                               Content="Close"
                               Click="CloseDefinition"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Padding="20,5"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Bottom controls -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="10">
            <!-- Progress -->
            <ProgressBar Value="{Binding Progress}"
                        Height="6"
                        Maximum="100"/>

            <TextBlock Text="{Binding ProgressText}"
                      HorizontalAlignment="Center"
                      Foreground="{Binding TextColor}"/>

            <!-- Playback controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Content="⏮ Prev" Click="PreviousWord" Padding="10,5"/>
                <Button Content="{Binding PlayPauseText}" Click="TogglePlayPause" Padding="15,5" FontWeight="Bold"/>
                <Button Content="Next ⏭" Click="NextWord" Padding="10,5"/>
                <Button Content="🔄 Reset" Click="Reset" Padding="10,5"/>
                <Button Content="📖 Define" Click="LookupDefinition" Padding="10,5"/>
            </StackPanel>

            <!-- Color controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="Colors:" VerticalAlignment="Center" Foreground="{Binding TextColor}"/>
                <Button Content="Light" Click="SetLightTheme" Padding="8,4"/>
                <Button Content="Dark" Click="SetDarkTheme" Padding="8,4"/>
                <Button Content="Sepia" Click="SetSepiaTheme" Padding="8,4"/>
                <Button Content="High Contrast" Click="SetHighContrastTheme" Padding="8,4"/>
            </StackPanel>

            <!-- Text input -->
            <TextBox Text="{Binding InputText, Mode=TwoWay}"
                    Height="80"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    Watermark="Paste your text here to start speed reading..."/>
        </StackPanel>
    </Grid>
</Window>
