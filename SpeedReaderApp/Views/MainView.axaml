<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpeedReaderApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="SpeedReaderApp.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{Binding BackgroundColor}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with controls -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="10">
            <TextBlock Text="Speed Reader"
                      FontSize="24"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Foreground="{Binding TextColor}"/>

            <!-- Speed controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Content="-"
                       Click="DecreaseSpeed"
                       Padding="15,8"
                       FontSize="20"/>
                <TextBlock Text="{Binding WPM, StringFormat='{}{0} WPM'}"
                          VerticalAlignment="Center"
                          FontSize="18"
                          FontWeight="Bold"
                          MinWidth="120"
                          TextAlignment="Center"
                          Foreground="{Binding TextColor}"/>
                <Button Content="+"
                       Click="IncreaseSpeed"
                       Padding="15,8"
                       FontSize="20"/>
            </StackPanel>

            <!-- Speed presets - scrollable for mobile -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                    <Button Content="250" Click="SetSpeed250" Padding="12,6" FontSize="14"/>
                    <Button Content="300" Click="SetSpeed300" Padding="12,6" FontSize="14"/>
                    <Button Content="400" Click="SetSpeed400" Padding="12,6" FontSize="14"/>
                    <Button Content="500" Click="SetSpeed500" Padding="12,6" FontSize="14"/>
                    <Button Content="1000" Click="SetSpeed1000" Padding="12,6" FontSize="14"/>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Text="💡 Best at 250-350 WPM"
                      FontSize="12"
                      HorizontalAlignment="Center"
                      Foreground="#FFA500"
                      TextWrapping="Wrap"
                      TextAlignment="Center"/>
        </StackPanel>

        <!-- Main reading area with tap gesture -->
        <Grid Grid.Row="1">
            <Border Background="{Binding BackgroundColor}"
                   Padding="15"
                   Tapped="OnWordTapped"
                   DoubleTapped="OnWordDoubleTapped">
                <Grid RowDefinitions="*,Auto,*">
                    <!-- Centered word display -->
                    <Viewbox Grid.Row="1"
                            MaxHeight="250"
                            Stretch="Uniform">
                        <TextBlock Text="{Binding CurrentWord}"
                                  FontSize="80"
                                  FontWeight="Bold"
                                  TextAlignment="Center"
                                  Foreground="{Binding TextColor}"
                                  Padding="20"/>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Definition popup -->
            <Border IsVisible="{Binding ShowDefinition}"
                   Background="#F0000000"
                   Padding="15"
                   Tapped="CloseDefinition">
                <Border Background="#FFFFFF"
                       CornerRadius="10"
                       Padding="15"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0"
                                  Text="Dictionary"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" MaxHeight="400">
                            <TextBlock Text="{Binding DefinitionText}"
                                      TextWrapping="Wrap"
                                      FontSize="16"/>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                               Content="Close"
                               Click="CloseDefinition"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               Padding="30,10"
                               FontSize="16"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Bottom controls -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="10">
                <!-- Progress -->
                <ProgressBar Value="{Binding Progress}"
                            Height="8"
                            Maximum="100"/>

                <TextBlock Text="{Binding ProgressText}"
                          HorizontalAlignment="Center"
                          FontSize="14"
                          Foreground="{Binding TextColor}"/>

                <!-- Playback controls -->
                <Grid ColumnDefinitions="*,*,*,*">
                    <Button Grid.Column="0"
                           Content="⏮"
                           Click="PreviousWord"
                           Padding="10"
                           FontSize="20"
                           Margin="2"/>
                    <Button Grid.Column="1"
                           Content="{Binding PlayPauseText}"
                           Click="TogglePlayPause"
                           Padding="10"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="2"/>
                    <Button Grid.Column="2"
                           Content="⏭"
                           Click="NextWord"
                           Padding="10"
                           FontSize="20"
                           Margin="2"/>
                    <Button Grid.Column="3"
                           Content="🔄"
                           Click="Reset"
                           Padding="10"
                           FontSize="20"
                           Margin="2"/>
                </Grid>

                <Button Content="📖 Lookup Definition"
                       Click="LookupDefinition"
                       Padding="15,10"
                       FontSize="16"
                       HorizontalAlignment="Stretch"/>

                <!-- Color controls -->
                <TextBlock Text="Theme:"
                          Foreground="{Binding TextColor}"
                          FontSize="14"
                          HorizontalAlignment="Center"/>

                <Grid ColumnDefinitions="*,*,*,*">
                    <Button Grid.Column="0" Content="Light" Click="SetLightTheme" Padding="8" Margin="2" FontSize="12"/>
                    <Button Grid.Column="1" Content="Dark" Click="SetDarkTheme" Padding="8" Margin="2" FontSize="12"/>
                    <Button Grid.Column="2" Content="Sepia" Click="SetSepiaTheme" Padding="8" Margin="2" FontSize="12"/>
                    <Button Grid.Column="3" Content="HiCon" Click="SetHighContrastTheme" Padding="8" Margin="2" FontSize="12"/>
                </Grid>

                <!-- Text input -->
                <TextBlock Text="Your Text:"
                          Foreground="{Binding TextColor}"
                          FontSize="14"/>
                <TextBox Text="{Binding InputText, Mode=TwoWay}"
                        Height="120"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        FontSize="14"
                        Watermark="Paste your text here..."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
